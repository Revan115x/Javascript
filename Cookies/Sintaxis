// ======================================================
// 🍪 COOKIES JAVASCRIPT — CHULETA
// ======================================================


// ------------------------------------------------------
// 🧠 ¿QUÉ ES UNA COOKIE?
// ------------------------------------------------------

// Una cookie es un pequeño dato de texto que el navegador
// guarda en el ordenador del usuario.

// Sirve para guardar información entre páginas o visitas:
// usuario, preferencias, sesión, idioma, etc.

// Las cookies pertenecen al dominio que las creó.
// Una página de otro dominio no puede leerlas.

// En JavaScript trabajamos con:
// document.cookie


// ======================================================
// 1. CREAR COOKIE
// ======================================================

document.cookie = "usuario=Juan";

// Crea una cookie llamada "usuario"
// y le asigna el valor "Juan".
//
// nombre = usuario
// valor  = Juan


// ------------------------------------------------------
// CREAR COOKIE CON CADUCIDAD
// ------------------------------------------------------

document.cookie =
    "usuario=Juan; expires=Thu, 31 Dec 2026 23:59:59 GMT";

// "expires" indica la FECHA EXACTA en la que caduca.
// Si no ponemos expires ni max-age,
// la cookie dura solamente durante la sesión.


// ------------------------------------------------------
// CREAR COOKIE CON max-age
// ------------------------------------------------------

document.cookie = "usuario=Juan; max-age=3600";

// max-age indica cuánto tiempo dura la cookie
// en SEGUNDOS.
//
// 3600 segundos = 60 minutos = 1 hora


// ------------------------------------------------------
// CREAR COOKIE CON path
// ------------------------------------------------------

document.cookie = "usuario=Juan; path=/";

// path indica desde qué ruta de la web
// se puede acceder a esa cookie.
//
// "/" significa que se puede acceder desde
// cualquier ruta del sitio.


// ------------------------------------------------------
// VARIAS OPCIONES
